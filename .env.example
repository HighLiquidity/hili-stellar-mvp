# Public Supabase client (safe to expose in the browser).
# Copy this file to `.env.local` and set your project values.
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Required for login (browser). Copy both from Supabase → Project Settings → API.
# Do not leave blank lines — empty values break auth.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used for password recovery emails when redirect is built outside the browser (optional in dev).
# Must match your deployed origin. Add the same URL under Supabase Auth → URL Configuration → Redirect URLs
# e.g. https://your-domain.com/reset-password

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# StellarExpert base for on-chain tx links (hash appended after `/tx/`). Default: testnet.
# Mainnet example: https://stellar.expert/explorer/public/tx/
# NEXT_PUBLIC_STELLAR_EXPERT_TX_URL=https://stellar.expert/explorer/testnet/tx/

# CorpX API v2 (server-only — never use NEXT_PUBLIC_* for these)
# Migration reference: https://docs.api.corpx.com/docs/guides/migrate-from-v1-reference
# Auth reference: https://docs.api.corpx.com/docs/guides/authentication

CORPX_AUTH_URL=https://auth.api.corpx.com
CORPX_CLIENT_ID=
CORPX_CLIENT_SECRET=
CORPX_TENANT_ID=

# PIX / REST (server-only). Host only OR .../v1 — paths add /v1/accounts/... automatically.
CORPX_API_URL=https://tenant.api.corpx.com
CORPX_ACCOUNT_ID=
# Default receiving PIX key for QR generation (must be registered on the account)
CORPX_PIX_KEY=

# Comma-separated webhook IPs. If set, ONLY these IPs are accepted by CorpXAdapter.validateWebhookIp.
# If unset, defaults match docs + CORPX_WEBHOOK_ALLOWED_IPS (same as /api/webhooks/corpx).
# CORPX_WEBHOOK_IPS=

# Comma-separated extra IPs allowed to POST /api/webhooks/corpx (CorpX defaults are built-in).
# CORPX_WEBHOOK_ALLOWED_IPS=

# CorpX portal: register webhook URL https://<your-host>/api/webhooks/corpx
# Subscribe at least to `qrcode.paid` (dynamic PIX deposit). Header: X-Webhook-Event: qrcode.paid

# Server-only (deposit limits, BRH balance, webhooks). Never use NEXT_PUBLIC_* or expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# In production, set to true only when you need the admin “+1 BRH (test)” button (Configurações).
# Always enabled when NODE_ENV=development.
# ENABLE_BRH_TEST_CREDIT=true

# On/Off-Ramp API (Stellar testnet, asset BRH) — server-only. See api-integration.md.
# Custodial on-ramp: omit `destination` on POST /v1/operations/onramp.
# Custodial off-ramp: POST /v1/operations/offramp after PIX withdraw (amount + externalId only).
# Callbacks: HMAC-SHA256 raw body, header X-Signature (hex). Must be HTTPS.
RAMP_API_BASE_URL=http://your-ramp-host:8080
RAMP_API_KEY=
RAMP_CALLBACK_SECRET=
# Required HTTPS (Ramp rejects http://). Prod: https://<your-domain>/api/webhooks/ramp
# Local dev: point to Vercel or ngrok — not http://localhost
# RAMP_CALLBACK_URL=https://your-domain.vercel.app/api/webhooks/ramp

# Legacy (unused — replaced by RAMP_API_*):
# BRH_MINT_API_URL=
# BRH_MINT_API_SECRET=

# BRH burn on fiat withdraw (server-only). If unset, withdraw still validates balance/limits; burn is skipped.
# BRH_BURN_API_URL=https://your-minter.example.com/v1/brh/burn
# BRH_BURN_API_SECRET=

# Binance REST API (server-only). Never expose these to the browser or use NEXT_PUBLIC_*.
# Default base URL: https://api.binance.com
BINANCE_BASE_URL=https://api.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Timeout in milliseconds for Binance REST calls. Default: 10000
BINANCE_TIMEOUT=10000
# Optional fallback min BRL notional for MARKET quoteOrderQty when exchangeInfo is unavailable.
# BINANCE_MARKET_MIN_NOTIONAL_BRL=10

# Optional pepper for API key secret hashing (server-only). Recommended in production.
# API_KEY_HASH_PEPPER=
# Public API rate limit per key (requests per minute). Default: 60
# API_KEY_RATE_LIMIT_PER_MINUTE=60
# Idempotency replay cache TTL for POST quote/lock (seconds). Default: 86400 (24h)
# API_KEY_IDEMPOTENCY_TTL_SECONDS=86400

# On-ramp quote generation (server-only). Optional overrides for the internal quote endpoint.
# ONRAMP_QUOTE_SYMBOL=USDCBRL
# Quote + PIX payment window (seconds). Defaults: 300 (5 min). PIX expiry is capped at quote expiry.
# ONRAMP_QUOTE_TTL_SECONDS=300
# ONRAMP_QUOTE_SPREAD_BPS=0
# ONRAMP_PIX_TTL_SECONDS=300
# CorpX dynamic PIX QR expiration is capped at ~24h (see corpx/pix/expiration.ts).
# Minimum remaining quote time required to lock (seconds). Default: 30
# ONRAMP_MIN_LOCK_REMAINING_SECONDS=30

# Multi-tenant clients (server-only). When true, on-ramp/off-ramp quotes require KYB approved.
# Default: disabled — legacy tenants stay operable without KYB gate.
# CLIENT_KYB_REQUIRED=true
#
# Network used when validating whitelisted withdraw wallets for on-ramp destination addresses.
# Options: STELLAR_TESTNET (default), STELLAR_PUBLIC
# ONRAMP_WITHDRAW_NETWORK=STELLAR_TESTNET
# Async refill target after user USDC delivery (server-only).
# ONRAMP_USDC_DISTRIBUTOR_ADDRESS=
# USDC delivery fee deducted from the quoted gross amount before Ramp pays the client. Default: 1
# ONRAMP_USDC_DELIVERY_FEE_USDC=1
# Minimum USDC amount for Binance distributor refill withdraw (Stellar/XLM). Default: 5
# ONRAMP_BINANCE_MIN_WITHDRAW_USDC=5
# Binance API network code for Stellar (UI label: "Stellar Network"). Typically XLM.
# ONRAMP_USDC_DISTRIBUTOR_NETWORK=XLM
# ONRAMP_USDC_DISTRIBUTOR_ADDRESS_TAG=
# ONRAMP_USDC_DISTRIBUTOR_NAME=
