# Public Supabase client (safe to expose in the browser).
# Copy this file to `.env.local` and set your project values.
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Required for login (browser). Copy both from Supabase → Project Settings → API.
# Do not leave blank lines — empty values break auth.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used for password recovery emails when redirect is built outside the browser (optional in dev).
# Must match your deployed origin. Add the same URL under Supabase Auth → URL Configuration → Redirect URLs
# e.g. https://your-domain.com/reset-password

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CorpX API (server-only — never use NEXT_PUBLIC_* for these)
# https://docs.corpxapi.com/docs/guides/authentication

CORPX_AUTH_URL=https://auth.corpxapi.com
CORPX_CLIENT_ID=
CORPX_CLIENT_SECRET=
CORPX_TENANT_ID=

# PIX / REST (server-only)
CORPX_API_URL=https://api.corpxapi.com
CORPX_ACCOUNT_ID=
# Default receiving PIX key for QR generation (must be registered on the account)
CORPX_PIX_KEY=

# Comma-separated webhook IPs. If set, ONLY these IPs are accepted by CorpXAdapter.validateWebhookIp.
# If unset, defaults match docs + CORPX_WEBHOOK_ALLOWED_IPS (same as /api/webhooks/corpx).
# CORPX_WEBHOOK_IPS=

# Comma-separated extra IPs allowed to POST /api/webhooks/corpx (CorpX defaults are built-in).
# CORPX_WEBHOOK_ALLOWED_IPS=

# CorpX portal: register webhook URL https://<your-host>/api/webhooks/corpx
# Subscribe at least to `qrcode.paid` (dynamic PIX deposit). Header: X-Webhook-Event: qrcode.paid

# Server-only (deposit limits, BRH balance, webhooks). Never use NEXT_PUBLIC_* or expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# In production, set to true only when you need the admin “+1 BRH (test)” button (Configurações).
# Always enabled when NODE_ENV=development.
# ENABLE_BRH_TEST_CREDIT=true

# On/Off-Ramp API (Stellar BRS) — server-only. See api-integration.md.
# Mint/burn wallets are custodial on the provider side; we do not pass a destination on on-ramp.
# State is driven by HTTPS callbacks to /api/webhooks/ramp after each operation call.
# Inbound PIX still credits `brh_balance`; on-ramp is skipped if unset.
RAMP_API_BASE_URL=https://api.example.com
RAMP_API_KEY=
# HMAC secret for POST /api/webhooks/ramp (X-Signature).
RAMP_CALLBACK_SECRET=
# Public HTTPS callback (required by Ramp). Defaults to NEXT_PUBLIC_SITE_URL + /api/webhooks/ramp
# Use ngrok/cloudflare tunnel in local dev, e.g. https://abc.ngrok.io/api/webhooks/ramp
# RAMP_CALLBACK_URL=

# Legacy (unused — replaced by RAMP_API_*):
# BRH_MINT_API_URL=
# BRH_MINT_API_SECRET=

# BRH burn on fiat withdraw (server-only). If unset, withdraw still validates balance/limits; burn is skipped.
# BRH_BURN_API_URL=https://your-minter.example.com/v1/brh/burn
# BRH_BURN_API_SECRET=
